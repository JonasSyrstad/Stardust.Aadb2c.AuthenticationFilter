<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	<PackageId>Veracity.OAuth.Tokens.Middleware</PackageId>
	<Version>1.0.0</Version>
	<Authors>Veracity by DNV</Authors>
	<Company>DNV</Company>
	<Description>Authentication middleware for Veracity services supporting both Azure AD B2C and Auth0 (IdP V2) token validation. Drop-in replacement for Stardust.Aadb2c.AuthenticationFilter with added Auth0 support.</Description>
	<PackageTags>OAuth2 Azure AAD B2C Auth0 Veracity Authentication JWT</PackageTags>
	<PackageProjectUrl>https://github.com/JonasSyrstad/Stardust.Aadb2c.AuthenticationFilter</PackageProjectUrl>
	<RepositoryUrl>https://github.com/JonasSyrstad/Stardust.Aadb2c.AuthenticationFilter</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
	<Copyright>Copyright © DNV 2025</Copyright>
	<PackageIcon>veracity-icon.png</PackageIcon>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<PackageReleaseNotes>Initial release: unified authentication middleware supporting both Azure AD B2C and Auth0 (IdP V2) token validation.</PackageReleaseNotes>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
	<ItemGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>
	<ItemGroup Condition=" '$(TargetFramework)' == 'net9.0' ">
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>
	<ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Stardust.Aadb2c.AuthenticationFilter.Core\Stardust.Aadb2c.AuthenticationFilter.Core.csproj" />
	</ItemGroup>
	<ItemGroup>
		<None Include="docs\veracity-icon.png" Pack="true" PackagePath="" />
		<None Include="docs\README.md" Pack="true" PackagePath="" />
	</ItemGroup>
</Project>
